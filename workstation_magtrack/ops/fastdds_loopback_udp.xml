<?xml version="1.0" encoding="UTF-8"?>
<!-- Use SYSTEM_DEFAULT discovery and unset ROS_LOCALHOST_ONLY with this file.
     Jazzy's LOCALHOST policy otherwise injects shared-memory transports. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>magtrack_loopback_udp</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList>
        <address>127.0.0.1</address>
      </interfaceWhiteList>
      <maxInitialPeersRange>64</maxInitialPeersRange>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="magtrack_loopback_udp" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>magtrack_loopback_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
      <builtin>
        <initialPeersList>
          <locator>
            <udpv4>
              <address>127.0.0.1</address>
            </udpv4>
          </locator>
        </initialPeersList>
      </builtin>
    </rtps>
  </participant>
</profiles>
